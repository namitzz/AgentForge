+def _reset_token_for(user):
+    from src.auth.password_reset import issue_reset_token
+    return issue_reset_token(user)
+
+
+def test_reset_accepts_strong_password(client, user_factory):
+    u = user_factory(email="jo@example.com", password="correct-horse-9")
+    token = _reset_token_for(u)
+    resp = client.post("/reset-password", json={"token": token, "new_password": "stronger-1234"})
+    assert resp.status_code == 200
+
+
+def test_reset_rejects_short_password(client, user_factory):
+    u = user_factory(email="jo@example.com", password="correct-horse-9")
+    token = _reset_token_for(u)
+    resp = client.post("/reset-password", json={"token": token, "new_password": "short1"})
+    assert resp.status_code == 400
+    assert resp.get_json()["error"] == "password_too_short"
+
