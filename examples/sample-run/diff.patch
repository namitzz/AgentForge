 """Reusable input validators."""

+import re
+
 EMAIL_RE = r"^[^@\s]+@[^@\s]+\.[^@\s]+$"

 def is_valid_email(value: str) -> bool:
@@ -8,3 +10,21 @@ def is_valid_email(value: str) -> bool:
     if not value:
         return False
     return bool(re.match(EMAIL_RE, value))
+
+
+def validate_password_strength(password: str) -> tuple[bool, str]:
+    """Return (ok, reason). Used by signup and password-reset alike.
+
+    Rules: at least 10 chars, at least one digit, not entirely whitespace.
+    """
+    if not password or not password.strip():
+        return False, "password_empty"
+    if len(password) < 10:
+        return False, "password_too_short"
+    if not any(ch.isdigit() for ch in password):
+        return False, "password_missing_digit"
+    return True, "ok"
